# STAGE stack on https://kroniq.srdc.com.tr (see README.md); read by every compose file of this folder (deploy.sh)
PUBLIC_HOST=https://kroniq.srdc.com.tr
SERVER_NAME=kroniq.srdc.com.tr

# Images on nexus (built and pushed as described in README.md)
FHIR_IMAGE=nexus.srdc.com.tr:18445/stage/fhir-repository:latest
ONAUTH_IMAGE=nexus.srdc.com.tr:18445/stage/onauth:latest
SMART_APPS_IMAGE=nexus.srdc.com.tr:18445/stage/smart-apps:latest
SHAP_CLIENT_IMAGE=nexus.srdc.com.tr:18445/stage/shap-client:latest
FHIR_RAG_MED_IMAGE=nexus.srdc.com.tr:18445/stage/fhir-rag-med:latest

# MongoDB data: the volume of the STAGE repository since 2024 (docker volume ls | grep vstagerepomongo)
STAGE_MONGO_VOLUME=stage_vstagerepomongo
# database of the repository in it
STAGE_DB_NAME=onfhir

# Host ports, on 127.0.0.1 only (the host's nginx proxies to them, see nginx-locations.conf). In use on the server
# otherwise: 7704-7706 FAIR Data Point / excel-extraction; 7701, 7703, 7707 and 7708 are free since this layout.
SMART_APPS_PORT=7700
STAGE_FHIR_PORT=7702
ONAUTH_PORT=7709

# true for one start only: onAuth reloads realm smart from onauth/conf/realms/smart (see onauth/docker-compose.yml)
ONAUTH_REALM_INIT=false
