# Deployment on https://kroniq.srdc.com.tr (see README.md in this folder)
PUBLIC_HOST=https://kroniq.srdc.com.tr

# Folder holding fhir-conf/ and application-docker.conf of stage-fhir-repository (relative to this folder, or absolute)
REPO_DIR=.

# Public paths (nginx locations, see nginx-locations.conf) and host ports (127.0.0.1 only: only nginx reaches them).
# Ports in use on the server (nginx): 4800-4865, 7700 smart-apps, 7701 smart-cds, 7704-7706 FDP / excel-extraction
STAGE_FHIR_PATH=/stage-fhir
STAGE_FHIR_PORT=7702
# SMART Health Links of each repository: <path>/shl -> the repository's port, /shl (no own container)
STAGE_SHL_PATH=/stage-shl
EHR_FHIR_PATH=/ehr
EHR_FHIR_PORT=7707
EHR_SHL_PATH=/shl-ehr

# MongoDB of the current STAGE repository (old compose: stage-repo-mongo, volume vstagerepomongo), kept with its data.
# Volume name as Docker lists it (docker volume ls | grep vstagerepomongo), usually <old compose project>_vstagerepomongo
STAGE_MONGO_VOLUME=stage_vstagerepomongo
# Database of the STAGE repository in it: mongodb.db of the old /repo/application.conf
STAGE_DB_NAME=onfhir
# Database of the EHR repository (new, in the same MongoDB)
EHR_DB_NAME=ehr

# Images
FHIR_IMAGE=nexus.srdc.com.tr:18445/stage/fhir-repository
